#!/usr/bin/env bash
# Block commits that contain secrets. Enable with: ln -sf ../../.githooks/pre-commit .git/hooks/pre-commit
# Bypass in an emergency with: git commit --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks not installed (brew install gitleaks) - skipping secret scan" >&2
    exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner -v
